# Database
DATABASE_URL="postgresql://user:password@localhost:5432/eggdirect"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Authentication
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# JWT
JWT_SECRET="your-jwt-secret-key-here-change-in-production"
JWT_EXPIRES_IN="7d"

# Email (for development, using Mailtrap or similar)
EMAIL_FROM="noreply@eggdirect.local"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""

# Payment Provider (Mock by default)
PAYMENT_PROVIDER="mock"
PAYMENT_API_KEY="mock_key"
PAYMENT_WEBHOOK_SECRET="mock_secret"

# Payout Provider
PAYOUT_PROVIDER="mock"
PAYOUT_API_KEY="mock_key"

# Storage (Mock by default)
STORAGE_PROVIDER="mock"
STORAGE_BUCKET="eggdirect-dev"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="mock"
STORAGE_SECRET_KEY="mock"

# Notification Provider
NOTIFICATION_PROVIDER="mock"
NOTIFICATION_API_KEY="mock_key"

# Application Settings
NEXT_PUBLIC_ENVIRONMENT="development"
LOG_LEVEL="debug"

# Verification Settings
VERIFICATION_DOCUMENT_TYPES="national_id,passport,bank_statement"
MAX_DOCUMENT_SIZE_MB="5"

# Commission Settings
DEFAULT_COMMISSION_RATE="0.10"
PLATFORM_COMMISSION_RATE="0.05"

# Escrow Settings
ESCROW_RELEASE_DAYS="3"
